# ── Google Maps ──────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── Anthropic Claude ─────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Vercel ───────────────────────────────────────────────────────
# Your Vercel API token (https://vercel.com/account/tokens)
VERCEL_TOKEN=
# The project name (used to derive the production URL: {name}.vercel.app)
VERCEL_PROJECT_NAME=business-previews
# Optional: link deployments to an existing project ID
VERCEL_PROJECT_ID=
# Optional: if your team project, add the team ID
VERCEL_TEAM_ID=

# ── Apollo.io ────────────────────────────────────────────────────
APOLLO_API_KEY=

# ── Gmail ────────────────────────────────────────────────────────
# Your Gmail address
GMAIL_USER=yourname@gmail.com
# App Password (NOT your real password) — see README for how to generate
GMAIL_APP_PASSWORD=

# ── Telegram ─────────────────────────────────────────────────────
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your personal chat ID (get from @userinfobot)
TELEGRAM_CHAT_ID=

# ── Google Sheets ────────────────────────────────────────────────
GOOGLE_SHEETS_ID=
# Paste the full JSON content of your service account credentials key file
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ── Sending identity ─────────────────────────────────────────────
FROM_NAME=Your Name

# ── Pipeline config ───────────────────────────────────────────────
TARGET_NICHE=plumber
TARGET_CITY=Auckland
DAILY_LIMIT=50

# ── Server ───────────────────────────────────────────────────────
PORT=3000
